# ── Qual IA conversa ─────────────────────────────────────────────
# offline (padrão, grátis) | ollama (local, grátis) | anthropic | openai_compatible
LLM_PROVIDER=offline
# LLM_MODEL=qwen2.5:3b
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_FALLBACK=offline          # se o provider principal falhar, usa este
# ANTHROPIC_API_KEY=sk-ant-...  # só para LLM_PROVIDER=anthropic
# LLM_API_KEY=                  # só para openai_compatible na nuvem

# ── Quais dados existem ──────────────────────────────────────────
# fake (simulado, determinístico) | stooq (histórico real, gratuito)
MARKET_DATA_SOURCE=fake
# TICKERS=AAPL,MSFT,NVDA        # com stooq, escolha os tickers dos EUA

# ── Job diário ───────────────────────────────────────────────────
FORECAST_HOUR_UTC=22

# ── Previsão de direção (ADR-005) ────────────────────────────────
# DIRECTION=off                 # desliga o classificador de direção
# DIRECTION_HORIZONS=2,5,20,60  # horizontes das features, em pregões
# DIRECTION_THRESHOLD=0.6       # só diz "alta" acima desta probabilidade

#!/usr/bin/env ruby
# frozen_string_literal: true

# Chama uma tool diretamente, sem IA nenhuma no meio.
#   bin/tool                                      → lista as tools e schemas
#   bin/tool get_stock_quote '{"ticker":"AAPL"}'  → executa
#   bin/tool forecast_price  '{"ticker":"PETR4"}' → lê a previsão salva
$LOAD_PATH.unshift File.expand_path("../lib", __dir__)
require "json"
require "marketpulse"

storage = MarketPulse::Storage.build
client = MarketPulse.market_client
MarketPulse.daily_job(storage: storage, client: client, logger: nil).run if storage.memory?
registry = MarketPulse.registry(storage: storage, client: client)

name, raw_input = ARGV
if name.nil?
  puts JSON.pretty_generate(registry.definitions.map(&:to_h))
  exit
end

begin
  puts JSON.pretty_generate(registry.call(name, JSON.parse(raw_input || "{}")))
rescue JSON::ParserError
  abort "Input inválido: passe um JSON entre aspas simples, ex.: '{\"ticker\":\"AAPL\"}'"
rescue StandardError => e
  abort "Erro (#{e.class}): #{e.message}"
end
